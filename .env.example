# Desenvolvimento local. Na Railway, use valores próprios de produção.
SECRET_KEY=change-me-in-your-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=

# Compatibilidade com o ambiente local legado:
# DJANGO_SECRET_KEY=change-me-in-your-local-env
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção: prefira a DATABASE_URL fornecida pela Railway.
DATABASE_URL=

POSTGRES_DB=jbs_store
POSTGRES_USER=jbs_store
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Mercado Pago Checkout Pro via Orders API (use credenciais de teste no desenvolvimento)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com

# Local: as mensagens aparecem nos logs, sem envio para a caixa de entrada.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="JBS Solar <no-reply@jbssolar.com.br>"

# No servidor: use django.core.mail.backends.smtp.EmailBackend e os dados
# do provedor contratado. O remetente deve ser autorizado pelo provedor.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# Conexão persistente com o banco.
DB_CONN_MAX_AGE=60
SECURE_HSTS_PRELOAD=False

# Hotmart: credenciais da API e token do webhook, sem valores reais.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_AUTH=
HOTMART_HOTTOK=
